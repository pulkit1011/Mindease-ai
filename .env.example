# Copy this file to ".env" and fill in your own values. NEVER commit ".env" to Git.
# If ANTHROPIC_API_KEY is left empty, the app still works using the offline fallback replies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=500
# Optional: change where the local SQLite database file is stored
# MINDEASE_DB_PATH=data/mindease.db
